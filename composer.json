{
    "name": "tgw-sistemas/parvus-framework",
    "type": "project",
    "require": {
        "php" : "^8.4",
        "ext-exif": "*",
        "illuminate/database": "^13.0",
        "illuminate/events": "^13.0",
        "illuminate/view": "^13.0",
        "phpmailer/phpmailer": "^7.1",
        "symfony/http-foundation" : "^8.1",
        "filp/whoops": "^2.18",
        "symfony/routing" : "^8.1"
    },
    "autoload": {
    	"files": [
            "src/helper/Lang.php",
            "src/helper/Debug.php",
            "src/helper/Text.php",
			"src/helper/Number.php"
        ],
        "psr-0": {
            "": "src/"
        },
        "psr-4": {
	        "Parvus\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "preferred-install": "dist"
    }
}
